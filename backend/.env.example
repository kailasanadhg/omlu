# OMLU Environment Configuration

# App
PROJECT_NAME="OMLU"
SECRET_KEY="replace-with-a-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Database
DATABASE_URL="postgresql+asyncpg://localhost:5432/omlu"
SYNC_DATABASE_URL="postgresql+psycopg://localhost:5432/omlu"

# Cloudinary (Sign up free at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Host URLs
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
